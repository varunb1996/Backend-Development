# Postgres connection string (Neon: Dashboard -> Connect -> copy the connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional tuning
PROCESSING_DELAY_SECONDS=30
SWEEP_INTERVAL_SECONDS=10
# LEASE_SECONDS=60
# RETRY_BACKOFF_SECONDS=5

# Only needed to run the test suite (use a separate, disposable database/branch)
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME_test?sslmode=require
